{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM"],
    "outDir": "./dist",
    "noEmit": true,
    "declaration": true,
    "declarationDir": "./dist"
  },
  "include": ["src/**/*.ts"]
}
